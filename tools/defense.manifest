# =============================================================================
# defense.manifest -- which defense this branch carries, and how to run it.
#
# THIS IS THE ONLY FILE THAT DIFFERS BETWEEN BRANCHES.
#
# tools/olsr-research.sh and tools/run_simulations.sh are byte-identical on
# every branch; they read this file to learn what to build and which flags a
# faithful run needs. That is what makes "switch branch, run dataset" a single
# command that cannot be configured wrongly by accident.
#
# It is sourced as a shell fragment, so: KEY=value, quote anything with spaces.
#
# FIELDS
#   DEFENSE_ID                short name; also the --defense selector and the
#                             prefix of generated dataset directory names.
#                             'none' means this branch carries no harness.
#   DEFENSE_NAME              human-readable name, shown in banners.
#   DEFENSE_BRANCH            the branch this manifest belongs to. 'doctor'
#                             compares it against HEAD, which catches a
#                             manifest that arrived on the wrong branch
#                             through a careless merge.
#   PAPER                     the publication being reproduced.
#   SCRATCH_TARGET            scratch program, without the .cc extension.
#                             The cmake target is scratch_<SCRATCH_TARGET>.
#   DEFENSE_FLAGS             harness arguments that EVERY faithful run needs.
#                             Applied automatically by olsr-research.sh.
#   BATCH_SEED_*              first --run seed of each canonical batch. The
#                             ranges are disjoint so batches stay statistically
#                             independent; keep them as published in
#                             docs/DATASETS.md or the existing datasets stop
#                             being comparable.
# =============================================================================

DEFENSE_ID=dcfm
DEFENSE_NAME="DCFM-OLSR"
DEFENSE_BRANCH=dcfm-defense
PAPER="Schweitzer et al. -- Achieving MANET protection without the use of superfluous fictitious nodes, Computer Communications (2024)"
SCRATCH_TARGET=olsr-dcfm-eval-mitigation

# Deliberately empty, and worth stating rather than leaving implicit.
#
# OlsrDefenseGcop's "Enabled" attribute defaults to FALSE, which looks like the
# TRUST default-flags trap but is NOT: here the harness owns that toggle. It
# creates every defense object with Enabled=false and flips it per measurement
# window through SetDefenseState() -- see the DEF-003 changelog entry and the
# SetAttribute("Enabled", ...) call in olsr-dcfm-eval-mitigation.cc. That is
# precisely what implements the 2x2 defense-on/off design, so forcing it on
# from the command line would BREAK the experiment rather than fix it.
#
# Do not take this on trust: defense_params.txt in every output directory
# records the parameters that were actually in effect for that run.
#
# NAMING: the class and its files say GCOP (src/olsr/model/olsr-defense-gcop.*,
# class OlsrDefenseGcop, TypeId ns3::olsr::OlsrDefenseGcop) while everything
# user-facing says DCFM. Same defense -- GCOP is the fictitious-node placement
# algorithm at its core. See docs/ARCHITECTURE.md.
DEFENSE_FLAGS=""

# Disjoint from trust (4M/6M), fpnt (1/2M) and watchdog (24M/26M).
BATCH_SEED_STATIC=20000001
BATCH_SEED_MOBILE=22000001
BATCH_SEED_STATIC_MIXED=30000001
BATCH_SEED_MOBILE_MIXED=32000001
