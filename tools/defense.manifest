# =============================================================================
# defense.manifest -- which defense this branch carries, and how to run it.
#
# THIS IS THE ONLY FILE THAT DIFFERS BETWEEN BRANCHES.
#
# tools/olsr-research.sh and tools/run_simulations.sh are byte-identical on
# every branch; they read this file to learn what to build and which flags a
# faithful run needs. That is what makes "switch branch, run dataset" a single
# command that cannot be configured wrongly by accident.
#
# It is sourced as a shell fragment, so: KEY=value, quote anything with spaces.
#
# FIELDS
#   DEFENSE_ID                short name; also the --defense selector and the
#                             prefix of generated dataset directory names.
#                             'none' means this branch carries no harness.
#   DEFENSE_NAME              human-readable name, shown in banners.
#   DEFENSE_BRANCH            the branch this manifest belongs to. 'doctor'
#                             compares it against HEAD, which catches a
#                             manifest that arrived on the wrong branch
#                             through a careless merge.
#   PAPER                     the publication being reproduced.
#   SCRATCH_TARGET            scratch program, without the .cc extension.
#                             The cmake target is scratch_<SCRATCH_TARGET>.
#   DEFENSE_FLAGS             harness arguments that EVERY faithful run needs.
#                             Applied automatically by olsr-research.sh.
#   BATCH_SEED_*              first --run seed of each canonical batch. The
#                             ranges are disjoint so batches stay statistically
#                             independent; keep them as published in
#                             docs/DATASETS.md or the existing datasets stop
#                             being comparable.
# =============================================================================

DEFENSE_ID=watchdog
DEFENSE_NAME="Watchdog-OLSR"
DEFENSE_BRANCH=watchdog-defense
PAPER="Baiad, Otrok, Muhaidat & Bentahar -- Cooperative Cross Layer Detection for Blackhole Attack in VANET-OLSR, IEEE IWCMC (2014)"
SCRATCH_TARGET=olsr-watchdog-eval-mitigation

# Deliberately empty. OlsrWatchdogDefense's "Enabled" attribute defaults to
# TRUE in the class -- but the harness overrides it: its install block creates
# every watchdog with Enabled=false, then flips it per measurement window
# through SetDefenseState(). That install-time override is what keeps the
# defense-off windows clean, and it is the 2x2 design; forcing the defense on
# from the command line would break it. The same install block hardcodes the
# watchdog's tuning, so there are no watchdog command-line flags.
#
# Do not take this on trust. Every per-attempt log in logs/ prints
# "Defense ACTIVATED" / "Defense DEACTIVATED" at each window transition, and
# windows_labels.csv records defense_enabled for every window.
#
# NOT the classic Marti et al. watchdog. This one is CROSS-LAYER: it
# corroborates forwarding observations with RTS/CTS evidence and MAC failures,
# per-node and with no inter-node cooperation messages. Its 16 attributes are
# listed in docs/RUNNING.md; three of them are documented "INERT." in the
# source and retained only so older scripts keep parsing.
#
# Unlike the other three, this branch's routing protocol carries NO
# promiscuous-monitoring code, because the defense object attaches its own PHY
# sniffer (MonitorSnifferRx, PhyRxDrop) in Setup() and schedules its own
# periodic check (m_periodicEvent). The empty HandleDefenseTimer() in the
# routing protocol is therefore correct here, not an oversight.
DEFENSE_FLAGS=""

# Disjoint from trust (4M/6M), fpnt (1/2M) and dcfm (20M/22M).
BATCH_SEED_STATIC=24000001
BATCH_SEED_MOBILE=26000001
BATCH_SEED_STATIC_MIXED=34000001
BATCH_SEED_MOBILE_MIXED=36000001
