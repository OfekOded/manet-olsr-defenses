# =============================================================================
# defense.manifest -- which defense this branch carries, and how to run it.
#
# THIS IS THE ONLY FILE THAT DIFFERS BETWEEN BRANCHES.
#
# tools/olsr-research.sh and tools/run_simulations.sh are byte-identical on
# every branch; they read this file to learn what to build and which flags a
# faithful run needs. That is what makes "switch branch, run dataset" a single
# command that cannot be configured wrongly by accident.
#
# It is sourced as a shell fragment, so: KEY=value, quote anything with spaces.
#
# FIELDS
#   DEFENSE_ID                short name; also the --defense selector and the
#                             prefix of generated dataset directory names.
#                             'none' means this branch carries no harness.
#   DEFENSE_NAME              human-readable name, shown in banners.
#   DEFENSE_BRANCH            the branch this manifest belongs to. 'doctor'
#                             compares it against HEAD, which catches a
#                             manifest that arrived on the wrong branch
#                             through a careless merge.
#   PAPER                     the publication being reproduced.
#   SCRATCH_TARGET            scratch program, without the .cc extension.
#                             The cmake target is scratch_<SCRATCH_TARGET>.
#   DEFENSE_FLAGS             harness arguments that EVERY faithful run needs.
#                             Applied automatically by olsr-research.sh.
#   BATCH_SEED_*              first --run seed of each canonical batch. The
#                             ranges are disjoint so batches stay statistically
#                             independent; keep them as published in
#                             docs/DATASETS.md or the existing datasets stop
#                             being comparable.
# =============================================================================

DEFENSE_ID=fpnt
DEFENSE_NAME="FPNT-OLSR"
DEFENSE_BRANCH=fpnt-defense
PAPER="Tan, Li & Dong -- Trust based routing mechanism for securing OLSR-based MANET, Ad Hoc Networks 30 (2015), pp. 84-98"
SCRATCH_TARGET=olsr-fpnt-eval-mitigation

# Deliberately empty, and that is worth stating rather than leaving implicit.
#
# Unlike the TRUST harness -- whose CLI defaults leave two of three detection
# mechanisms switched off -- this harness's defaults already reproduce the
# paper: maliciousThreshold=0.2, uncertaintyBeta=0.6, fadingFactor=0.7,
# cheatThreshold=2, trustUpdateInterval=5s. OlsrDefenseFpnt follows the rule
# that any behaviour beyond the paper's text sits behind an attribute whose
# default reproduces the paper.
#
# Two variants exist and are NOT enabled here, because no dataset was generated
# with them: --redundantMpr (the FPNT-OLSR(R) redundant-MPR-coverage variant of
# section 5.3) and MonitorTcForwarding (in the paper, but off by default here).
# See docs/HANDOFF.md, "suggested next steps".
DEFENSE_FLAGS=""

# As published in docs/DATASETS.md. The canonical and mixed ranges are disjoint
# so the two are statistically independent.
BATCH_SEED_STATIC=1
BATCH_SEED_MOBILE=2000001
BATCH_SEED_STATIC_MIXED=10000001
BATCH_SEED_MOBILE_MIXED=12000001
